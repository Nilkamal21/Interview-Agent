# Groq API Configuration
# Replace 'your_key_here' with your actual Groq API key.
# Rename this file to '.env' for local development. Do not commit your '.env' file.
GROQ_API_KEY=your_key_here

# Public URL of the deployed application (used for keep-alive self-pinging on Render/Railway).
# Leave blank for local development to disable self-ping logs.
SELF_URL=https://your-app-name.onrender.com
